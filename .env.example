# Copy to .env.local and fill in. All of these are server-side only:
# never prefix a data or AI key with NEXT_PUBLIC_.

# Database
MONGODB_URI=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Market data
FINNHUB_API_KEY=

# AI
GEMINI_API_KEY=

# Email
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=
