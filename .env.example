# Copy to .env.local and fill in. All of these are server-side only:
# never prefix a data or AI key with NEXT_PUBLIC_.

# Database
MONGODB_URI=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Market data
FINNHUB_API_KEY=

# AI (OpenAI API key, billed separately from ChatGPT). Writes the welcome email
# intro and the digest summaries; emails fall back to plain text without it.
OPENAI_API_KEY=

# Email (a Gmail address and a Google app password, not the account password)
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# Background jobs. Set INNGEST_DEV=1 locally and run `npx inngest-cli@latest dev`.
# The two keys come from Inngest Cloud and are only needed in production.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
